<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <!-- PWA: IIS no conoce .webmanifest; sw.js no se cachea para que los cambios lleguen enseguida -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <security>
      <requestFiltering>
        <!-- Subida de documentación: hasta 64 MB por envío (PHP pone el límite fino en .user.ini) -->
        <requestLimits maxAllowedContentLength="67108864" />
        <fileExtensions>
          <add fileExtension=".ini" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
